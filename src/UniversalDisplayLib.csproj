<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>universaldisplaylib</AssemblyName>
		<Platforms>AnyCPU</Platforms>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>

		<!-- KEEP THE LINE NUMBERS, DROP THE PERSONAL PATH.

		     The shipped .pdb is what puts file names and line numbers into a crash
		     report, and that is worth having - a server owner's log named
		     BEUniversalDisplay.cs line 1702 on 2026-08-01 and that was the whole
		     diagnosis. But without this the path is absolute, so every stranger's
		     log also carried "E:\Game Mods\Vintage Story Mods (AI)\Window Display\...".

		     PathMap rewrites the source root recorded in the symbols, so traces now
		     read "src\psurface\BEUniversalDisplay.cs:line 1702" with nothing about this
		     machine in front of it. Nothing else changes.

		     Remove the .pdb from the zip instead if you would rather have neither,
		     but then crash reports lose their line numbers. -->
		<PathMap>$(MSBuildProjectDirectory)=.</PathMap>
	</PropertyGroup>
	<!-- Pre-psurface classes, kept on disk for reference but not built:
	     Window Storage Lib registers these same class names. -->
	<ItemGroup>
		<Compile Remove="src\legacy\**" />
		<Compile Remove="tools\**" />
		<None Include="tools\**" />
		<Compile Remove="backup\**" />
		<None Include="backup\**" />
		<None Include="src\legacy\**" />
		<!-- the regression runner (tests\TallWindowTests.csproj) is its own project -->
		<Compile Remove="tests\**" />
		<!-- the measured-window tests (tests-auto\AutoTests.csproj, from the Auto Prototype) too -->
		<Compile Remove="tests-auto\**" />
		<None Include="tests-auto\**" />
		<None Include="tests\**" />
	</ItemGroup>

	<!-- THE LIB'S ASSETS ARE NOT BUILD OUTPUT any more, as of 2026-08-08.

	     They live in the working folder mods\universaldisplaylib_<version>\assets\, beside
	     its modinfo.json and modicon.png, exactly as every content mod's do, and package2.py
	     zips them straight from there. Only the dll, pdb and deps come out of bin\.

	     They used to sit in a project-root assets\ folder and reach the zip through a copy
	     step here. That gave the lib two homes and both bit within one evening: a blocktype
	     authored in the mods\ folder never reached the game, because the ROOT copy was the
	     one being packaged. Do not re-add this Include without moving the assets back and
	     changing package2.py to match - one source, or the question returns. -->

	<!-- WHERE THE GAME DLLS ARE.

	     On your PC nothing changes: the default below is the same install folder the
	     references always pointed at. The cloud (Claude Code on the web) has no game
	     installed, so its startup script (.claude/hooks/session-start.sh) downloads one
	     and sets the VINTAGE_STORY environment variable to that folder, which wins here. -->
	<PropertyGroup>
		<VintageStoryPath Condition="'$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintageStoryPath>
		<VintageStoryPath Condition="'$(VintageStoryPath)' == ''">..\..\..\..\..\Games\Vintage Story\Vintage Story Launcher\Vintage Story Versions\1.22.3</VintageStoryPath>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="0Harmony">
			<HintPath>$(VintageStoryPath)\Lib\0Harmony.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Newtonsoft.Json">
			<HintPath>$(VintageStoryPath)\Lib\Newtonsoft.Json.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="protobuf-net">
			<HintPath>$(VintageStoryPath)\Lib\protobuf-net.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="SkiaSharp">
			<HintPath>$(VintageStoryPath)\Lib\SkiaSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Vintagestory">
			<HintPath>$(VintageStoryPath)\Vintagestory.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VintagestoryAPI">
			<HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VintagestoryLib">
			<HintPath>$(VintageStoryPath)\VintagestoryLib.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VSEssentials">
			<HintPath>$(VintageStoryPath)\Mods\VSEssentials.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VSSurvivalMod">
			<HintPath>$(VintageStoryPath)\Mods\VSSurvivalMod.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>
